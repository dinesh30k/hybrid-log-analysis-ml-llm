   "source": [
    "import math\n",
    "\n",
    "def sigmoid(z: float) -> float:\n",
    "    result = 1 / (1 + math.exp(-z))\n",
    "    return round(result, 4)\n",
    "\n",
    "z = 0\n",
    "\n",
    "\n",
    "print(sigmoid(z))\n"
   ]
